{
    "tasks": [
        {
            "type": "shell",
            "label": "Build OpenGL project",
            "command": "cmake -S \"${workspaceFolder}\" -B \"${workspaceFolder}/build-task-02\" && cmake --build \"${workspaceFolder}/build-task-02\"",
            "options": {
